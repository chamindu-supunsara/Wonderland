{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["enabled", "frontendOrigin", "cognito", "images", "apiReplicas", "apis", "secrets", "workers"],
  "properties": {
    "enabled": {"type": "boolean"},
    "frontendOrigin": {"type": "string"},
    "pricingMode": {"enum": ["http", "projection"]},
    "apiReplicas": {"type": "integer", "minimum": 2, "maximum": 3},
    "cognito": {
      "type": "object", "additionalProperties": false,
      "required": ["region", "userPoolId", "userPoolClientId"],
      "properties": {
        "region": {"const": "ap-south-1"},
        "userPoolId": {"type": "string", "pattern": "^ap-south-1_[A-Za-z0-9]+$"},
        "userPoolClientId": {"type": "string", "pattern": "^[a-z0-9]{1,128}$"}
      }
    },
    "images": {
      "type": "object", "additionalProperties": {"type": "string"},
      "required": ["catalog", "booking", "payment", "admission", "analytics"]
    },
    "apis": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "catalog": {"$ref": "#/definitions/enabled"},
        "booking": {"$ref": "#/definitions/enabled"},
        "payment": {"$ref": "#/definitions/enabled"},
        "admission": {"$ref": "#/definitions/enabled"}
      }
    },
    "secrets": {
      "type": "object", "required": ["catalog", "booking", "payment", "admission", "analytics"],
      "additionalProperties": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63}
    },
    "workers": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["enabled", "service", "command"],
        "properties": {
          "enabled": {"type": "boolean"},
          "service": {"enum": ["catalog", "booking", "payment", "admission", "analytics"]},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "env": {"type": "object", "additionalProperties": false, "properties": {
            "EVENTS_TOPIC_ARN": {"type": "string"}, "PRICING_QUEUE_URL": {"type": "string"},
            "BOOKING_QUEUE_URL": {"type": "string"}, "ADMISSION_QUEUE_URL": {"type": "string"}
          }}
        }
      }
    }
  },
  "definitions": {
    "enabled": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}
    }
  }
}
