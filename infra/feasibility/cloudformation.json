{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Wonderland Step09 isolated MOCK EKS / HTTP API feasibility experiment",
  "Parameters": {
    "OperatorArn": {
      "Type": "String",
      "AllowedPattern": "arn:aws:iam::708919751353:(role|user)/.+"
    },
    "OperatorCidr": {
      "Type": "String",
      "AllowedPattern": "\\d{1,3}(\\.\\d{1,3}){3}/32"
    },
    "KubernetesVersion": {
      "Type": "String",
      "Default": "1.35",
      "AllowedPattern": "1\\.\\d{2}"
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.89.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {}
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "RouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "InternetRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      },
      "DependsOn": "GatewayAttachment"
    },
    "Subnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.89.0.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true
      }
    },
    "RouteAssociation1": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "SubnetId": {
          "Ref": "Subnet1"
        }
      }
    },
    "Subnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.89.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true
      }
    },
    "RouteAssociation2": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "RouteTable"
        },
        "SubnetId": {
          "Ref": "Subnet2"
        }
      }
    },
    "ControlPlaneSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Step09 ControlPlaneSg",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "NodeSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Step09 NodeSg",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "AlbSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Step09 AlbSg",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "LinkSg": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Step09 LinkSg",
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "NodeToControlPlane": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "ControlPlaneSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "NodeSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443
      }
    },
    "ControlPlaneToKubelet": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "NodeSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "ControlPlaneSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 10250,
        "ToPort": 10250
      }
    },
    "ControlPlaneToWebhooks": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "NodeSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "ControlPlaneSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 443,
        "ToPort": 443
      }
    },
    "ControlPlaneToDnsTcp": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "NodeSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "ControlPlaneSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 53,
        "ToPort": 53
      }
    },
    "ControlPlaneToDnsUdp": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "NodeSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "ControlPlaneSg"
        },
        "IpProtocol": "udp",
        "FromPort": 53,
        "ToPort": 53
      }
    },
    "NodeToNode": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "NodeSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "NodeSg"
        },
        "IpProtocol": "-1"
      }
    },
    "LinkToAlb": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "AlbSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "LinkSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 80,
        "ToPort": 80
      }
    },
    "AlbToNodePort": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "NodeSg"
        },
        "SourceSecurityGroupId": {
          "Ref": "AlbSg"
        },
        "IpProtocol": "tcp",
        "FromPort": 30080,
        "ToPort": 30080
      }
    },
    "ClusterRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "eks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEKSClusterPolicy"
          }
        ]
      }
    },
    "NodeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEKSWorkerNodePolicy"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEC2ContainerRegistryPullOnly"
          },
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonEKS_CNI_Policy"
          }
        ]
      }
    },
    "Cluster": {
      "Type": "AWS::EKS::Cluster",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "Version": {
          "Ref": "KubernetesVersion"
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "ClusterRole",
            "Arn"
          ]
        },
        "UpgradePolicy": {
          "SupportType": "STANDARD"
        },
        "AccessConfig": {
          "AuthenticationMode": "API",
          "BootstrapClusterCreatorAdminPermissions": false
        },
        "ResourcesVpcConfig": {
          "SubnetIds": [
            {
              "Ref": "Subnet1"
            },
            {
              "Ref": "Subnet2"
            }
          ],
          "SecurityGroupIds": [
            {
              "Ref": "ControlPlaneSg"
            }
          ],
          "EndpointPrivateAccess": true,
          "EndpointPublicAccess": true,
          "PublicAccessCidrs": [
            {
              "Ref": "OperatorCidr"
            }
          ]
        }
      }
    },
    "OperatorAccess": {
      "Type": "AWS::EKS::AccessEntry",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "PrincipalArn": {
          "Ref": "OperatorArn"
        },
        "Type": "STANDARD",
        "AccessPolicies": [
          {
            "PolicyArn": {
              "Fn::Sub": "arn:${AWS::Partition}:eks::aws:cluster-access-policy/AmazonEKSClusterAdminPolicy"
            },
            "AccessScope": {
              "Type": "cluster"
            }
          }
        ]
      }
    },
    "LaunchTemplate": {
      "Type": "AWS::EC2::LaunchTemplate",
      "Properties": {
        "LaunchTemplateData": {
          "SecurityGroupIds": [
            {
              "Ref": "NodeSg"
            }
          ],
          "InstanceType": "t3.medium",
          "MetadataOptions": {
            "HttpTokens": "required",
            "HttpPutResponseHopLimit": 1
          },
          "BlockDeviceMappings": [
            {
              "DeviceName": "/dev/xvda",
              "Ebs": {
                "VolumeSize": 20,
                "VolumeType": "gp3",
                "Encrypted": true,
                "DeleteOnTermination": true
              }
            }
          ]
        }
      }
    },
    "Nodes": {
      "Type": "AWS::EKS::Nodegroup",
      "Properties": {
        "ClusterName": {
          "Ref": "Cluster"
        },
        "NodeRole": {
          "Fn::GetAtt": [
            "NodeRole",
            "Arn"
          ]
        },
        "Subnets": [
          {
            "Ref": "Subnet1"
          },
          {
            "Ref": "Subnet2"
          }
        ],
        "AmiType": "AL2023_x86_64_STANDARD",
        "CapacityType": "ON_DEMAND",
        "ScalingConfig": {
          "MinSize": 1,
          "MaxSize": 1,
          "DesiredSize": 1
        },
        "LaunchTemplate": {
          "Id": {
            "Ref": "LaunchTemplate"
          },
          "Version": {
            "Fn::GetAtt": [
              "LaunchTemplate",
              "LatestVersionNumber"
            ]
          }
        }
      },
      "DependsOn": [
        "InternetRoute",
        "RouteAssociation1",
        "RouteAssociation2",
        "NodeToControlPlane",
        "ControlPlaneToKubelet",
        "NodeToNode"
      ]
    },
    "Repository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "EmptyOnDelete": true,
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        }
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Protocol": "HTTP",
        "Port": 30080,
        "TargetType": "instance",
        "HealthCheckPath": "/smoke/health",
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "10"
          }
        ]
      }
    },
    "LoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internal",
        "Type": "application",
        "Subnets": [
          {
            "Ref": "Subnet1"
          },
          {
            "Ref": "Subnet2"
          }
        ],
        "SecurityGroups": [
          {
            "Ref": "AlbSg"
          }
        ]
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "LoadBalancer"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "VpcLink": {
      "Type": "AWS::ApiGatewayV2::VpcLink",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "SubnetIds": [
          {
            "Ref": "Subnet1"
          },
          {
            "Ref": "Subnet2"
          }
        ],
        "SecurityGroupIds": [
          {
            "Ref": "LinkSg"
          }
        ]
      }
    },
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}"
        },
        "ProtocolType": "HTTP"
      }
    },
    "Integration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "HTTP_PROXY",
        "IntegrationMethod": "ANY",
        "IntegrationUri": {
          "Ref": "Listener"
        },
        "ConnectionType": "VPC_LINK",
        "ConnectionId": {
          "Ref": "VpcLink"
        },
        "PayloadFormatVersion": "1.0",
        "TimeoutInMillis": 10000,
        "RequestParameters": {
          "overwrite:path": "$request.path"
        }
      }
    },
    "Route": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "GET /smoke/health",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Join": [
            "/",
            [
              "integrations",
              {
                "Ref": "Integration"
              }
            ]
          ]
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingBurstLimit": 5,
          "ThrottlingRateLimit": 2
        }
      }
    }
  },
  "Outputs": {
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "RepositoryUri": {
      "Value": {
        "Fn::GetAtt": [
          "Repository",
          "RepositoryUri"
        ]
      }
    },
    "TargetGroupArn": {
      "Value": {
        "Ref": "TargetGroup"
      }
    },
    "VpcId": {
      "Value": {
        "Ref": "Vpc"
      }
    },
    "NodeGroupName": {
      "Value": {
        "Fn::GetAtt": [
          "Nodes",
          "NodegroupName"
        ]
      }
    },
    "ApiEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Api",
          "ApiEndpoint"
        ]
      }
    },
    "ApiId": {
      "Value": {
        "Ref": "Api"
      }
    },
    "VpcLinkId": {
      "Value": {
        "Ref": "VpcLink"
      }
    }
  }
}
